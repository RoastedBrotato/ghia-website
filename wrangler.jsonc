{
  // Cloudflare Workers — the static export in ./out, plus a small Worker
  // (worker/index.ts) that only handles /api/* (the enquiry form).
  // Build with `npm run build`, then deploy with `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghia-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    // Everything except the API is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Service. The ENQUIRY_FROM domain must be onboarded to
  // Email Sending on the deploying account (`wrangler email sending enable <domain>`).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "ENQUIRY_TO": "ghiatechonologies@gmail.com",
    "ENQUIRY_FROM": "website@ghiatechonlogies.com"
  },
  "observability": { "enabled": true }
}
